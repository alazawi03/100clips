{
  "name": "100clips-api",
  "version": "0.1.0",
  "private": true,
  "description": "100clips API: NestJS on the Supabase database, used by the brand dashboard and the creator app.",
  "scripts": {
    "build": "nest build",
    "start": "node dist/src/main.js",
    "dev": "nest start --watch",
    "test": "tsc -p tsconfig.json && node --test dist/test/",
    "openapi": "tsc -p tsconfig.json && node dist/src/common/openapi/export.js",
    "db:types": "node scripts/db-types.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "jose": "^5.10.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.23.1",
    "typescript": "^5.9.3"
  }
}
