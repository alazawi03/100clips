# Copy to .env and fill in. Never commit .env.

# Supabase project URL (Project Settings > API).
SUPABASE_URL=https://kwxoplenxwciacyfbqeo.supabase.co

# Postgres connection for the API (Project Settings > Database > Connection string, "Transaction pooler").
# The API runs each request as the signed-in user, so row-level security still applies.
DATABASE_URL=postgresql://postgres.kwxoplenxwciacyfbqeo:[YOUR-PASSWORD]@aws-1-eu-central-1.pooler.supabase.com:6543/postgres

# Only for projects still on the legacy shared JWT secret. Leave empty to verify tokens with the
# project's signing keys (JWKS), which is the default for new projects.
SUPABASE_JWT_SECRET=

PORT=4000
# The brand dashboard's address, for CORS. Comma-separated for several.
CORS_ORIGINS=http://localhost:3000
