  "info": {
    "title": "100clips API",
    "description": "For the brand dashboard and the creator app. Sign in with Supabase Auth and send the access token as `Authorization: Bearer <token>`. Each request runs as that user in Postgres, so row-level security decides what they see.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "Supabase access token"
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "example": true
          }
        },
        "required": [
          "ok"
        ]
      },
      "JoinWaitlistDto": {
        "type": "object",
        "properties": {
          "country": {
            "type": "string",
            "description": "ISO country code",
            "example": "SA",
            "pattern": "^[A-Za-z]{2}$"
          },
          "contact": {
            "type": "string",
            "description": "A phone number or an email",
            "example": "+966501234567",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "required": [
          "country",
          "contact"
        ]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "statusCode": {
            "type": "integer",
            "example": 400
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ],
            "description": "What went wrong, for people. Input checks give a list.",
            "example": "Choose an address"
          },
          "error": {
            "type": "string",
            "example": "Bad Request"
          },
          "code": {
            "type": "string",
            "description": "Postgres error code, when the database refused",
            "example": "23514"
          }
        },
        "required": [
          "statusCode",
          "message"
        ]
      },
      "Role": {
        "type": "string",
        "enum": [
          "creator",
          "brand",
          "admin"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Role"
              }
            ]
          },
          "name_ar": {
            "type": "string",
            "nullable": true
          },
          "name_en": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true
          },
          "notifications_seen_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "role",
          "name_ar",
          "name_en",
          "phone",
          "notifications_seen_at",
          "created_at"
        ]
      },
      "CreatorStatus": {
        "type": "string",
        "enum": [
          "incomplete",
          "pending",
          "changes_requested",
          "rejected",
          "approved"
        ]
      },
      "Gender": {
        "type": "string",
        "enum": [
          "female",
          "male"
        ]
      },
      "Niche": {
        "type": "string",
        "enum": [
          "general",
          "beauty",
          "food",
          "fashion",
          "family",
          "fitness",
          "travel",
          "tech",
          "gaming"
        ]
      },
      "Creator": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "allOf": [
              {
                "$ref": "#/components/schemas/CreatorStatus"
              }
            ]
          },
          "name_ar": {
            "type": "string",
            "nullable": true
          },
          "name_en": {
            "type": "string",
            "nullable": true
          },
          "handle": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "example": "BH"
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Gender"
              }
            ]
          },
          "shows_face": {
            "type": "boolean",
            "nullable": true
          },
          "niches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Niche"
            }
          },
          "photo_path": {
            "type": "string",
            "nullable": true
          },
          "approved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completed_orders": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "status",
          "name_ar",
          "name_en",
          "handle",
          "country",
          "city",
          "bio",
          "gender",
          "shows_face",
          "niches",
          "photo_path",
          "approved_at",
          "completed_orders",
          "created_at",
          "updated_at"
        ]
      },
      "Industry": {
        "type": "string",
        "enum": [
          "food_beverage",
          "fashion",
          "tech",
          "real_estate",
          "automotive",
          "health",
          "education",
          "home_living",
          "other"
        ]
      },
      "Brand": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "account_id": {
            "type": "string",
            "format": "uuid"
          },
          "name_ar": {
            "type": "string",
            "nullable": true
          },
          "name_en": {
            "type": "string",
            "nullable": true
          },
          "logo_path": {
            "type": "string",
            "nullable": true,
            "description": "Path in the public storage bucket"
          },
          "industry": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Industry"
              }
            ]
          },
          "about": {
            "type": "string",
            "nullable": true
          },
          "website": {
            "type": "string",
            "nullable": true
          },
          "instagram": {
            "type": "string",
            "nullable": true
          },
          "tiktok": {
            "type": "string",
            "nullable": true
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "account_id",
          "name_ar",
          "name_en",
          "logo_path",
          "industry",
          "about",
          "website",
          "instagram",
          "tiktok",
          "created_at",
          "updated_at"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "creator": {
            "nullable": true,
            "description": "Creators only",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Creator"
              }
            ]
          },
          "brands": {
            "description": "Brand owners only; empty for creators",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Brand"
            }
          }
        },
        "required": [
          "account",
          "creator",
          "brands"
        ]
      },
      "CreateAccountDto": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "creator",
              "brand"
            ],
            "description": "Admins are made by hand, never through the API"
          },
          "name_ar": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "name_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "phone": {
            "type": "string",
            "minLength": 6,
            "maxLength": 20,
            "example": "+97333123456"
          }
        },
        "required": [
          "role"
        ]
      },
      "ExploreCreator": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name_ar": {
            "type": "string",
            "nullable": true
          },
          "name_en": {
            "type": "string",
            "nullable": true
          },
          "handle": {
            "type": "string"
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Gender"
              }
            ]
          },
          "niches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Niche"
            }
          },
          "photo_path": {
            "type": "string",
            "nullable": true
          },
          "completed_orders": {
            "type": "integer"
          },
          "rating": {
            "type": "number",
            "nullable": true,
            "description": "Average stars, null before the first review"
          },
          "review_count": {
            "type": "integer"
          },
          "from_price": {
            "type": "number",
            "nullable": true,
            "description": "Lowest format price in BHD, before the platform fee"
          }
        },
        "required": [
          "id",
          "name_ar",
          "name_en",
          "handle",
          "city",
          "bio",
          "gender",
          "niches",
          "photo_path",
          "completed_orders",
          "rating",
          "review_count",
          "from_price"
        ]
      },
      "PublicCreator": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name_ar": {
            "type": "string",
            "nullable": true
          },
          "name_en": {
            "type": "string",
            "nullable": true
          },
          "handle": {
            "type": "string"
          },
          "country": {
            "type": "string",
            "example": "BH"
          },
          "city": {
            "type": "string",
            "nullable": true
          },
          "bio": {
            "type": "string",
            "nullable": true
          },
          "gender": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/Gender"
              }
            ]
          },
          "shows_face": {
            "type": "boolean",
            "nullable": true
          },
          "niches": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Niche"
