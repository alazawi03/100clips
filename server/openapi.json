        "required": [
          "format",
          "price"
        ]
      },
      "SocialPlatform": {
        "type": "string",
        "enum": [
          "instagram",
          "tiktok"
        ]
      },
      "Social": {
        "type": "object",
        "properties": {
          "platform": {
            "allOf": [
              {
                "$ref": "#/components/schemas/SocialPlatform"
              }
            ]
          },
          "username": {
            "type": "string"
          }
        },
        "required": [
          "platform",
          "username"
        ]
      },
      "PortfolioVideo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "video_path": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "video_path"
        ]
      },
      "Rating": {
        "type": "object",
        "properties": {
          "rating": {
            "type": "number"
          },
          "review_count": {
            "type": "integer"
          }
        },
        "required": [
          "rating",
          "review_count"
        ]
      },
      "Review": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "brand_name_ar": {
            "type": "string",
            "nullable": true
          },
          "brand_name_en": {
            "type": "string",
            "nullable": true
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "review": {
            "type": "string",
            "nullable": true
          },
          "rated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "order_id",
          "brand_name_ar",
          "brand_name_en",
          "rating",
          "review",
          "rated_at"
        ]
      },
      "Clip": {
        "type": "object",
        "properties": {
          "order_id": {
            "type": "string",
            "format": "uuid"
          },
          "brand_name_ar": {
            "type": "string",
            "nullable": true
          },
          "brand_name_en": {
            "type": "string",
            "nullable": true
          },
          "views": {
            "type": "integer",
            "nullable": true
          },
          "approved_at": {
            "type": "string",
            "format": "date-time"
          },
          "video_path": {
            "type": "string"
          },
          "duration_sec": {
            "type": "integer",
            "nullable": true
          }
        },
        "required": [
          "order_id",
          "brand_name_ar",
          "brand_name_en",
          "views",
          "approved_at",
          "video_path",
          "duration_sec"
        ]
      },
      "CreatorProfile": {
        "type": "object",
        "properties": {
          "creator": {
            "$ref": "#/components/schemas/PublicCreator"
          },
          "formats": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FormatPrice"
            }
          },
          "socials": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Social"
            }
          },
          "portfolio": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PortfolioVideo"
            }
          },
          "rating": {
            "nullable": true,
            "description": "Null before the first review",
            "type": "object",
            "allOf": [
              {
                "$ref": "#/components/schemas/Rating"
              }
            ]
          },
          "reviews": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Review"
            }
          },
          "clips": {
            "description": "Clips the brand agreed to show publicly",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Clip"
            }
          }
        },
        "required": [
          "creator",
          "formats",
          "socials",
          "portfolio",
          "rating",
          "reviews",
          "clips"
        ]
      },
      "CreateBrandDto": {
        "type": "object",
        "properties": {
