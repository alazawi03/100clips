          },
          "photo_path": {
            "type": "string",
            "nullable": true
          },
          "approved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "completed_orders": {
            "type": "integer"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "name_ar",
          "name_en",
          "handle",
          "country",
          "city",
          "bio",
          "gender",
          "shows_face",
          "niches",
          "photo_path",
          "approved_at",
          "completed_orders",
          "created_at",
          "updated_at"
        ]
      },
      "ContentFormat": {
        "type": "string",
        "enum": [
          "tiktok_video",
          "instagram_reel",
          "instagram_story"
        ]
      },
      "FormatPrice": {
