          },
          "industry": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Industry"
              }
            ]
          },
          "about": {
            "type": "string",
            "maxLength": 300
          },
          "website": {
            "type": "string",
            "format": "uri",
            "example": "https://example.com"
          },
          "instagram": {
            "type": "string",
            "minLength": 1,
            "maxLength": 30,
            "description": "Username, without @"
          },
          "tiktok": {
            "type": "string",
