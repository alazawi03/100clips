{
  "info": {
    "name": "100clips API",
    "description": "The 100clips NestJS API (server/).\n\nSetup:\n1. Start the API: `cd server && npm run dev` (needs server/.env, see .env.example).\n2. Create a test user: Supabase dashboard > Authentication > Users > Add user (tick \"Auto confirm\"), or use \"Sign up\" below if email confirmation is off.\n3. Set `email` and `password` in the collection variables, run \"Sign in\". It saves the access token into `token`, and every other request uses it.\n4. Run the folders in order. Each request has tests (see the Test Results tab).\n\nTo test as a second person (e.g. a creator), sign in with another user: the token is replaced.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "supabaseUrl", "value": "https://kwxoplenxwciacyfbqeo.supabase.co" },
    { "key": "supabaseKey", "value": "sb_publishable_t6xi2A_7L7Fj2mjPyyizWA_MeJBPZfO", "description": "The project's publishable key: safe to share, it only identifies the project." },
    { "key": "email", "value": "", "description": "A real address. Supabase Auth rejects example.com and similar test domains. Gmail plus-addresses work: you+brand@gmail.com" },
    { "key": "password", "value": "change-me-123" },
    { "key": "token", "value": "", "description": "Filled by \"Sign in\"." },
    { "key": "userId", "value": "", "description": "Filled by \"Sign in\"." },
    { "key": "brandId", "value": "", "description": "Filled by \"Add a brand\"." },
    { "key": "creatorId", "value": "", "description": "Filled by \"Explore creators\" (first result), or set by hand." }
  ],
  "item": [
    {
      "name": "0. Supabase sign-in",
      "description": "Gets an access token from Supabase Auth. The apps do the same through the Supabase SDK.",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Sign up (email)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Supabase accepted the sign-up', () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
            "const body = pm.response.json();",
            "if (body.access_token) {",
            "  pm.collectionVariables.set('token', body.access_token);",
            "  pm.collectionVariables.set('userId', body.user.id);",
            "} else {",
            "  console.log('No token yet: confirm the email first (or add the user in the dashboard with Auto confirm), then run Sign in.');",
            "}"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabaseKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": { "raw": "{{supabaseUrl}}/auth/v1/signup", "host": ["{{supabaseUrl}}"], "path": ["auth", "v1", "signup"] }
          }
        },
        {
          "name": "Sign in (email + password)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Signed in', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.collectionVariables.set('token', body.access_token);",
            "pm.collectionVariables.set('userId', body.user.id);",
            "pm.test('Token saved', () => pm.expect(body.access_token).to.be.a('string'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [
              { "key": "apikey", "value": "{{supabaseKey}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}" },
            "url": {
              "raw": "{{supabaseUrl}}/auth/v1/token?grant_type=password",
              "host": ["{{supabaseUrl}}"],
              "path": ["auth", "v1", "token"],
              "query": [{ "key": "grant_type", "value": "password" }]
            }
          }
        }
      ]
    },
    {
      "name": "1. Public (no sign-in)",
      "auth": { "type": "noauth" },
      "item": [
        {
          "name": "Health",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('API and database are up', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().ok).to.eql(true);",
            "});"
          ] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] } }
        },
        {
          "name": "Join waitlist (email)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Joined', () => pm.response.to.have.status(204));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"country\": \"SA\",\n  \"contact\": \"reem@example.com\"\n}" },
            "url": { "raw": "{{baseUrl}}/waitlist", "host": ["{{baseUrl}}"], "path": ["waitlist"] }
          }
        },
        {
          "name": "Join waitlist (phone)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Joined', () => pm.response.to.have.status(204));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"country\": \"KW\",\n  \"contact\": \"+965 9876-5432\"\n}" },
            "url": { "raw": "{{baseUrl}}/waitlist", "host": ["{{baseUrl}}"], "path": ["waitlist"] }
          }
        },
        {
          "name": "Join waitlist (junk is refused)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400 with the database message', () => {",
            "  pm.response.to.have.status(400);",
            "  pm.expect(pm.response.json().message).to.be.a('string');",
            "});"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"country\": \"SA\",\n  \"contact\": \"not a contact\"\n}" },
            "url": { "raw": "{{baseUrl}}/waitlist", "host": ["{{baseUrl}}"], "path": ["waitlist"] }
          }
        }
      ]
    },
    {
      "name": "2. Me (sign-up step)",
      "description": "Run \"Sign in\" first. A new user has no account until they choose creator or brand.",
      "item": [
        {
          "name": "Get me (before choosing a role: 404)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404 for a new user, 200 once the account exists', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));"
          ] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] } }
        },
        {
          "name": "Create account as brand",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Created (or 409 if this user already has an account)', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));",
            "if (pm.response.code === 201) pm.test('Role is brand', () => pm.expect(pm.response.json().role).to.eql('brand'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"brand\",\n  \"name_ar\": \"محمصة المحرق\",\n  \"name_en\": \"Muharraq Roastery\"\n}" },
            "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
          }
        },
        {
          "name": "Create account as creator (use a different user)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Created (or 409 if this user already has an account)', () => pm.expect(pm.response.code).to.be.oneOf([201, 409]));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"creator\",\n  \"phone\": \"+97339001122\"\n}" },
            "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
          }
        },
        {
          "name": "Create account as admin (refused)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Admins are never made through the API', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"role\": \"admin\"\n}" },
            "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] }
          }
        },
        {
          "name": "Get me",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Account, creator profile and brands', () => {",
            "  pm.response.to.have.status(200);",
            "  const body = pm.response.json();",
            "  pm.expect(body).to.have.keys('account', 'creator', 'brands');",
            "  pm.expect(body.account.id).to.eql(pm.collectionVariables.get('userId'));",
            "});"
          ] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] } }
        }
      ]
    },
    {
      "name": "3. Brands (signed in as a brand owner)",
      "item": [
        {
          "name": "Add a brand",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Created', () => pm.response.to.have.status(201));",
            "pm.collectionVariables.set('brandId', pm.response.json().id);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name_ar\": \"محمصة المحرق\",\n  \"name_en\": \"Muharraq Roastery\",\n  \"industry\": \"food_beverage\",\n  \"about\": \"Specialty coffee roasted in Muharraq.\",\n  \"website\": \"https://example.com\",\n  \"instagram\": \"muharraq.roastery\"\n}" },
            "url": { "raw": "{{baseUrl}}/brands", "host": ["{{baseUrl}}"], "path": ["brands"] }
          }
        },
        {
          "name": "My brands",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Lists the brand just added', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().map(b => b.id)).to.include(pm.collectionVariables.get('brandId'));",
            "});"
          ] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/brands", "host": ["{{baseUrl}}"], "path": ["brands"] } }
        },
        {
          "name": "Edit the brand",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Only the sent field changed', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().about).to.eql('Single-origin coffee, roasted weekly.');",
            "});"
          ] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"about\": \"Single-origin coffee, roasted weekly.\"\n}" },
            "url": { "raw": "{{baseUrl}}/brands/{{brandId}}", "host": ["{{baseUrl}}"], "path": ["brands", "{{brandId}}"] }
          }
        },
        {
          "name": "Add a brand without a name (refused)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400: a brand needs a name', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"industry\": \"other\"\n}" },
            "url": { "raw": "{{baseUrl}}/brands", "host": ["{{baseUrl}}"], "path": ["brands"] }
          }
        },
        {
          "name": "Edit a brand that isn't yours (404)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404: other accounts can\\'t see or change it', () => pm.response.to.have.status(404));"
          ] } }],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"about\": \"hijacked\"\n}" },
            "url": { "raw": "{{baseUrl}}/brands/00000000-0000-0000-0000-000000000099", "host": ["{{baseUrl}}"], "path": ["brands", "00000000-0000-0000-0000-000000000099"] }
          }
        }
      ]
    },
    {
      "name": "4. Creators",
      "description": "Explore is empty until a creator is approved (there's no admin endpoint yet: approve one in the database).",
      "item": [
        {
          "name": "Explore creators",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('A list (empty until a creator is approved)', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json()).to.be.an('array');",
            "});",
            "const first = pm.response.json()[0];",
            "if (first) pm.collectionVariables.set('creatorId', first.id);"
          ] } }],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/creators?limit=24&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["creators"],
              "query": [{ "key": "limit", "value": "24" }, { "key": "offset", "value": "0" }]
            }
          }
        },
        {
          "name": "Explore by niche",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Only that niche', () => {",
            "  pm.response.to.have.status(200);",
            "  pm.response.json().forEach(c => pm.expect(c.niches).to.include('beauty'));",
            "});"
          ] } }],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/creators?niche=beauty",
              "host": ["{{baseUrl}}"],
              "path": ["creators"],
              "query": [{ "key": "niche", "value": "beauty", "description": "general, beauty, food, fashion, family, fitness, travel, tech, gaming" }]
            }
          }
        },
        {
          "name": "Explore with an unknown niche (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/creators?niche=cooking", "host": ["{{baseUrl}}"], "path": ["creators"], "query": [{ "key": "niche", "value": "cooking" }] }
          }
        },
        {
          "name": "Creator profile",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('Profile, or 404 if you can\\'t see this creator', () => pm.expect(pm.response.code).to.be.oneOf([200, 404]));",
            "if (pm.response.code === 200) pm.test('Has prices, socials and portfolio', () => {",
            "  pm.expect(pm.response.json()).to.include.keys('creator', 'formats', 'socials', 'portfolio', 'reviews', 'clips');",
            "});"
          ] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/creators/{{creatorId}}", "host": ["{{baseUrl}}"], "path": ["creators", "{{creatorId}}"] } }
        }
      ]
    },
    {
      "name": "5. Errors",
      "item": [
        {
          "name": "No token (401)",
          "auth": { "type": "noauth" },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 Sign in first', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] } }
        },
        {
          "name": "Expired or fake token (401)",
          "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "not-a-real-token", "type": "string" }] },
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 session expired', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "method": "GET", "url": { "raw": "{{baseUrl}}/me", "host": ["{{baseUrl}}"], "path": ["me"] } }
        },
        {
          "name": "Unknown field (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('400: unknown fields are refused', () => pm.response.to.have.status(400));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name_en\": \"Test\",\n  \"industry\": \"other\",\n  \"account_id\": \"00000000-0000-0000-0000-000000000001\"\n}" },
            "url": { "raw": "{{baseUrl}}/brands", "host": ["{{baseUrl}}"], "path": ["brands"] }
          }
        }
      ]
    }
  ]
}
