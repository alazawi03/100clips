# Copy to .env.local and fill in. The publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://kwxoplenxwciacyfbqeo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_t6xi2A_7L7Fj2mjPyyizWA_MeJBPZfO
# The 100clips API (the 100clips-backend repo), called from the server only.
API_URL=http://localhost:4000
# Server only, never NEXT_PUBLIC_: encrypts what someone types when signing up with an email that already has a laqta
# login, until they open the emailed link (lib/pending-signup.ts). At least 32 random characters, e.g.
# `openssl rand -hex 32`. In production it's a Worker secret: `npx wrangler secret put SIGNUP_COOKIE_KEY`. Empty: they
# choose the password again after opening the link.
SIGNUP_COOKIE_KEY=
# Where public files (logos, product photos) are served: the R2 public bucket's address, same as
# R2_PUBLIC_URL in 100clips-backend/.env.
NEXT_PUBLIC_MEDIA_URL=
